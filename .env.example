# Configuración de ELEBENSAT Docker
# Copiar este archivo a .env antes de levantar el stack

# Puerto HTTP expuesto por elebensat_web en 127.0.0.1
ELEBENSAT_HTTP_PORT=8080

# Credenciales de MySQL 8.0
MYSQL_ROOT_PASSWORD=root_elebensat_secure_2026
MYSQL_DATABASE=visor_xml_db
MYSQL_USER=elebensat_user
MYSQL_PASSWORD=elebensat_secret_pwd_2026

# Variables consumidas por database.php
DB_HOST=elebensat_db
DB_PORT=3306
DB_DATABASE=visor_xml_db
DB_USER=elebensat_user
DB_PASSWORD=elebensat_secret_pwd_2026

# Llave de cifrado AES-256 para contraseñas de correo, CONTPAQ y Oracle
# Formato: base64:<32 bytes en base64>
SGKSAT_SECRET_KEY=base64:cGl0YXlhY29kZV9lbGViZW5zYXRfc2VjcmV0XzIwMjZfa2V5ISE=
